{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "routes": [
    { "src": "/css/(.*)",      "dest": "/css/$1"      },
    { "src": "/js/(.*)",       "dest": "/js/$1"        },
    { "src": "/firebase/(.*)", "dest": "/firebase/$1"  },
    { "src": "/(.*\\.json)",   "dest": "/$1"           },
    { "src": "/(.*)",          "dest": "/index.html"   }
  ]
}
